{
  "name": "memory-system-mvp",
  "version": "0.5.0-local.0",
  "private": true,
  "description": "Local conversational memory SDK built on an attributed LongMemory source revision",
  "type": "module",
  "main": "./build-product/product/index.js",
  "types": "./build-product/product/index.d.ts",
  "exports": {
    ".": {
      "types": "./build-product/product/index.d.ts",
      "import": "./build-product/product/index.js"
    }
  },
  "files": [
    "build-product/product",
    "build-product/longmemory",
    "examples-product",
    "LICENSE",
    "UPSTREAM-LONGMEMORY-LICENSE",
    "ATTRIBUTION.md",
    "README-product.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.product.json && node scripts/copy-longmemory-schema.mjs",
    "typecheck": "tsc -p tsconfig.product.json --noEmit",
    "test": "npm run build && node --test tests-product/*.test.mjs",
    "prepack": "npm run build"
  },
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziningshu-code/memory-system-mvp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3"
  }
}
