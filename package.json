{
  "name": "topic-memory",
  "version": "0.1.1",
  "description": "A standalone TypeScript SDK that adds topic-based long-term conversation memory to existing LLM applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "examples",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js && node --test tests/*.test.mjs",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "prepack": "npm run build",
    "demo": "npm run build && node examples/minimal-node.mjs",
    "demo:chat": "npm run build && node --env-file=.env examples/chat.mjs",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "evaluate:live": "npm run build && node --env-file=.env scripts/evaluate.mjs --live",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "preview": "node scripts/serve-site.mjs"
  },
  "keywords": [
    "llm",
    "llm-memory",
    "long-term-memory",
    "conversation-memory",
    "agent-memory",
    "ai-agent",
    "context-management",
    "conversational-ai",
    "chatbot",
    "typescript",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziningshu-code/memory-system-mvp.git"
  },
  "homepage": "https://github.com/ziningshu-code/memory-system-mvp#readme",
  "bugs": {
    "url": "https://github.com/ziningshu-code/memory-system-mvp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.3"
  }
}
