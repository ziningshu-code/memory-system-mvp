{
  "name": "memory-system-mvp",
  "version": "0.5.0-beta.1",
  "private": false,
  "description": "Local conversational memory SDK with exact transcripts and source-grounded recall, built on a modified LongMemory core",
  "type": "module",
  "main": "./build-product/product/index.js",
  "types": "./build-product/product/index.d.ts",
  "exports": {
    ".": {
      "types": "./build-product/product/index.d.ts",
      "import": "./build-product/product/index.js"
    }
  },
  "files": [
    "build-product/product",
    "build-product/longmemory",
    "examples-product",
    ".env.example",
    "LICENSE",
    "UPSTREAM-LONGMEMORY-LICENSE",
    "ATTRIBUTION.md",
    "NOTICE",
    "docs/sdk.md",
    "docs/privacy.md",
    "docs/generation-1.md",
    "docs/project-evolution.md",
    "docs/release-notes.md"
  ],
  "scripts": {
    "build": "node scripts/clean-product-build.mjs && tsc -p tsconfig.product.json && node scripts/copy-longmemory-schema.mjs",
    "typecheck": "tsc -p tsconfig.product.json --noEmit",
    "test": "npm run build && node --test tests-product/*.test.mjs",
    "prepack": "npm run build",
    "smoke:consumer": "node scripts/consumer-smoke.mjs"
  },
  "license": "MIT AND Apache-2.0",
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "stemmer": "^2.0.1",
    "@types/better-sqlite3": "^7.6.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^5.9.3"
  },
  "repository": {
    "url": "git+https://github.com/ziningshu-code/memory-system-mvp.git",
    "type": "git"
  },
  "homepage": "https://github.com/ziningshu-code/memory-system-mvp#readme",
  "keywords": [
    "memory",
    "conversation",
    "transcript",
    "local-first",
    "llm",
    "sdk"
  ]
}
